{
  "id": "settler",
  "title": "A settler by the fire",
  "start": "greet",
  "nodes": {
    "greet": {
      "speaker": "Settler (P)",
      "text": "You're not from the coast villages. Farmer's hands, though. What do you want?",
      "choices": [
        {
          "text": "What is this place?",
          "next": "place"
        },
        {
          "text": "I need a blade. Can you spare one?",
          "next": "blade",
          "if": {
            "notFlag": "settler.sword"
          }
        },
        {
          "text": "Get out of my way.",
          "next": "rude",
          "do": {
            "infamy": 2,
            "standing": {
              "coastFolk": -5
            }
          }
        },
        {
          "text": "Is there work on this road?",
          "next": "work",
          "if": {
            "notFlag": "quest:clearRoad"
          }
        },
        {
          "text": "The camp on the Coast Road is cleared.",
          "next": "thanks",
          "if": {
            "flag": "cleared:coastCamp",
            "notFlag": "road.clear"
          },
          "do": {
            "questEvent": "settler.roadClear"
          }
        },
        {
          "text": "Nothing. Goodbye.",
          "next": "end"
        }
      ]
    },
    "place": {
      "speaker": "Settler (P)",
      "text": "A few houses on the Coast Road, a day out of Sentinel. We keep the fire lit and the road clear. Mostly.",
      "choices": [
        {
          "text": "Thank you.",
          "next": "greet",
          "do": {
            "standing": {
              "coastFolk": 2
            }
          }
        }
      ]
    },
    "blade": {
      "speaker": "Settler (P)",
      "text": "Spare one? Steel costs. Give me a reason.",
      "choices": [
        {
          "text": "[Speech 25] The road isn't clear. I can help keep it that way.",
          "check": {
            "skill": "Speech",
            "level": 25,
            "pass": "bladeYes",
            "fail": "bladeNo"
          }
        },
        {
          "text": "Never mind.",
          "next": "greet"
        }
      ]
    },
    "bladeYes": {
      "speaker": "Settler (P)",
      "text": "Fair. Take it, and bring it back clean.",
      "choices": [
        {
          "text": "Take the sword.",
          "next": "end",
          "do": {
            "give": {
              "IronSword": 1
            },
            "setFlag": "settler.sword",
            "standing": {
              "coastFolk": 3
            }
          }
        }
      ]
    },
    "bladeNo": {
      "speaker": "Settler (P)",
      "text": "Words are cheap on this road. No.",
      "choices": [
        {
          "text": "Fine.",
          "next": "greet"
        }
      ]
    },
    "rude": {
      "speaker": "Settler (P)",
      "text": "Walk on, then.",
      "choices": [
        {
          "text": "Leave.",
          "next": "end"
        }
      ]
    },
    "work": {
      "speaker": "Settler (P)",
      "text": "There's a camp on the Coast Road, east of here. Four of them, one with an axe. They take a toll in salt and teeth. Clear them out and I'll see you right.",
      "choices": [
        {
          "text": "I'll deal with them.",
          "next": "greet",
          "do": {
            "startQuest": "clearRoad"
          }
        },
        {
          "text": "Not my business.",
          "next": "greet"
        }
      ]
    },
    "thanks": {
      "speaker": "Settler (P)",
      "text": "Cleared? Then the carts can run again. Here, this is what I have. Bind yourself up before the next one.",
      "choices": [
        {
          "text": "Thanks.",
          "next": "greet"
        }
      ]
    }
  }
}
